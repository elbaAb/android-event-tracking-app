<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cat">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Sign out button -->
        <Button
            android:id="@+id/buttonSignOut"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="Sign Out"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Current month and year -->
        <TextView
            android:id="@+id/textCurrentMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="August 2026"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonSignOut" />

        <!-- Previous month button -->
        <ImageButton
            android:id="@+id/buttonPreviousMonth"
            android:layout_width="82dp"
            android:layout_height="78dp"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous month"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_monochrome"
            app:layout_constraintBottom_toBottomOf="@id/textCurrentMonth"
            app:layout_constraintEnd_toStartOf="@id/textCurrentMonth"
            app:layout_constraintTop_toTopOf="@id/textCurrentMonth" />


        <!-- Next month button -->
        <ImageButton
            android:id="@+id/buttonNextMonth"
            android:layout_width="82dp"
            android:layout_height="78dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next month"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_launcher_monochrome"
            android:rotation="180"
            app:layout_constraintBottom_toBottomOf="@id/textCurrentMonth"
            app:layout_constraintStart_toEndOf="@id/textCurrentMonth"
            app:layout_constraintTop_toTopOf="@id/textCurrentMonth" />

        <!-- Create Event button -->
        <Button
            android:id="@+id/buttonCreateEvent"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="Create Event"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textCurrentMonth" />

        <!-- Reminders button -->
        <Button
            android:id="@+id/buttonRemindersFilter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Reminders"
            app:layout_constraintStart_toEndOf="@id/buttonCreateEvent"
            app:layout_constraintTop_toTopOf="@id/buttonCreateEvent" />

        <!-- Categories filter button -->
        <Button
            android:id="@+id/buttonCategoriesFilter"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Categories"
            app:layout_constraintStart_toEndOf="@id/buttonRemindersFilter"
            app:layout_constraintTop_toTopOf="@id/buttonCreateEvent" />
        <!-- Calendar grid -->
        <TableLayout
            android:id="@+id/calendarTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:stretchColumns="*"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonCreateEvent">

            <!-- Day-of-week headers -->
            <TableRow>

                <TextView
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Sun"
                    android:textStyle="bold" />

                <TextView
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Mon"
                    android:textStyle="bold" />

                <TextView
