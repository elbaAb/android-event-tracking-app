                    android:textStyle="bold" />

                <TextView
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Fri"
                    android:textStyle="bold" />

                <TextView
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="Sat"
                    android:textStyle="bold" />

            </TableRow>

